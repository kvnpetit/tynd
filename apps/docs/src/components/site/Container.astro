---
interface Props {
  size?: "default" | "narrow";
  class?: string;
}
const { size = "default", class: className = "" } = Astro.props;
---

<div class:list={["container", size, className]}><slot /></div>

<style>
  .container {
    margin-inline: auto;
    padding-inline: 1.5rem;
    max-width: 72rem;
  }
  .narrow {
    max-width: 48rem;
  }
</style>
