---
import Button from "../components/site/Button.astro";
import Container from "../components/site/Container.astro";
import SectionTitle from "../components/site/SectionTitle.astro";
import Base from "../layouts/Base.astro";
import { SITE } from "../lib/site";
---

<Base
  title="Changelog - Tynd"
  description="Unreleased changes and published Tynd releases."
  canonicalPath="/changelog/"
  noindex
>
  <section class="head">
    <Container>
      <SectionTitle as="h1" title="Changelog" />
    </Container>
  </section>
  <section class="body">
    <Container>
      <Button href={`${SITE.links.github}/blob/main/CHANGELOG.md`} external>Read the repository changelog</Button>
      <Button href={SITE.links.releases} variant="secondary" external>View published releases</Button>
    </Container>
  </section>
</Base>

<style>
  .head {
    padding-block: 4rem;
    border-bottom: 1px solid var(--border);
  }
  .body {
    padding-block: 3rem;
  }
  .body :global(.container) {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    text-align: center;
  }
</style>
