{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "root": false,
  "extends": ["../../biome.json"],
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!dist",
      "!.astro",
      "!public/docs",
      "!src/content/docs",
      "!**/*.astro"
    ]
  },
  "overrides": [
    {
      "includes": ["src/lib/sidebar.ts"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    },
    {
      "includes": ["src/styles/site.css"],
      "linter": { "rules": { "complexity": { "noImportantStyles": "off" } } }
    },
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
