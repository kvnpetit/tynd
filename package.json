{
  "name": "tynd",
  "version": "1.0.0",
  "description": "Native desktop apps in TypeScript — workspace root.",
  "license": "Apache-2.0",
  "author": "Kevin Petit <74395438+kvnpetit@users.noreply.github.com> (https://github.com/kvnpetit)",
  "homepage": "https://tynd.kvnpetit.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tynd-apps/tynd.git"
  },
  "bugs": {
    "url": "https://github.com/tynd-apps/tynd/issues"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '@tynd/*' typecheck",
    "lint": "biome lint",
    "format": "biome format --write",
    "format:check": "biome format",
    "check": "biome check --write",
    "check:ts": "biome ci && bun run typecheck",
    "fmt:rust": "cargo fmt --all",
    "fmt:rust:check": "cargo fmt --all -- --check",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "deny:check": "cargo deny check",
    "deps:check": "cargo shear",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo check --workspace --all-targets && cargo deny check && cargo shear && cargo test --workspace",
    "check:all": "bun run check:ts && bun run check:rust && bun run test",
    "fix:all": "biome check --write && cargo fmt --all",
    "test": "bun test && cargo test --workspace --quiet",
    "test:ts": "bun test",
    "test:rust": "cargo test --workspace",
    "test:e2e": "bun test e2e/",
    "bench:rust": "cargo bench -p tynd-host",
    "coverage:ts": "bun test --coverage",
    "coverage:rust": "cargo llvm-cov --workspace --html"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@tynd/core": "workspace:*",
    "@types/bun": "latest",
    "typescript": "~6.0.2"
  },
  "keywords": [
    "tynd",
    "desktop",
    "webview",
    "typescript",
    "bun",
    "rust",
    "monorepo"
  ]
}
