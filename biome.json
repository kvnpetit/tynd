{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": false
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.{js,mjs,cjs,jsx,ts,tsx,json,jsonc}",
      "!**/node_modules",
      "!**/target",
      "!**/dist",
      "!**/.tynd",
      "!**/bin/index.js",
      "!**/bun.lock",
      "!**/release",
      "!packages/host-src/native",
      "!crates/host/src/webview/shim/devalue.bundle.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "bracketSpacing": true
    },
    "globals": ["Bun"]
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    },
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": false
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedPrivateClassMembers": "error",
        "noUndeclaredVariables": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useImportType": "error",
        "useExportType": "error",
        "useNodejsImportProtocol": "error",
        "useConst": "error",
        "useTemplate": "error",
        "useShorthandAssign": "error",
        "noParameterAssign": "error",
        "noUselessElse": "error",
        "useNumberNamespace": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noDoubleEquals": "error",
        "noEmptyBlockStatements": "error",
        "noImplicitAnyLet": "error",
        "noConsole": "error",
        "noConfusingVoidType": "error",
        "noMisleadingCharacterClass": "error"
      },
      "complexity": {
        "noBannedTypes": "error",
        "noExcessiveCognitiveComplexity": "error",
        "noExcessiveLinesPerFunction": "error",
        "noUselessTypeConstraint": "error",
        "noUselessUndefined": "error",
        "noForEach": "off",
        "useLiteralKeys": "error",
        "useMaxParams": "error",
        "useOptionalChain": "error"
      },
      "performance": {
        "noAccumulatingSpread": "error",
        "noDelete": "error"
      },
      "security": {
        "noGlobalEval": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["crates/**/*.js"],
      "linter": {
        "rules": {
          "complexity": {
            "noArguments": "off",
            "noExcessiveCognitiveComplexity": "off",
            "noExcessiveLinesPerFunction": "off",
            "useArrowFunction": "off",
            "useOptionalChain": "off"
          },
          "correctness": {
            "noInnerDeclarations": "off"
          },
          "style": {
            "noParameterAssign": "off",
            "useTemplate": "off"
          },
          "suspicious": {
            "noRedundantUseStrict": "off"
          }
        }
      }
    },
    {
      "includes": ["crates/host/src/debug/debug_helper.js"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/client/log.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
