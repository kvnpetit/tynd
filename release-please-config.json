{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "rust",
  "packages": {
    "packages/host-rs": { "release-type": "rust", "package-name": "tynd-host" },
    "packages/full":    { "release-type": "rust", "package-name": "tynd-full" },
    "packages/lite":    { "release-type": "rust", "package-name": "tynd-lite" },
    "packages/core":    { "release-type": "node", "package-name": "@tynd/core" },
    "packages/host":    { "release-type": "node", "package-name": "@tynd/host" }
  },
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "tynd",
      "components": ["tynd-host", "tynd-full", "tynd-lite", "@tynd/core", "@tynd/host"]
    }
  ],
  "include-component-in-tag": true,
  "bootstrap-sha": "HEAD"
}
