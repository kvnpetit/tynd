{
  "name": "@tynd/plugin-http-server",
  "version": "1.0.0",
  "description": "Embedded HTTP + WebSocket server for Tynd apps — powered by Bun.serve.",
  "license": "Apache-2.0",
  "author": "Kevin Petit <74395438+kvnpetit@users.noreply.github.com> (https://github.com/kvnpetit)",
  "homepage": "https://tynd-apps.github.io/tynd/docs/v1.0/api/plugins/http-server",
  "funding": "https://github.com/sponsors/kvnpetit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tynd-apps/tynd.git",
    "directory": "plugins/standalone/http-server"
  },
  "bugs": {
    "url": "https://github.com/tynd-apps/tynd/issues"
  },
  "keywords": [
    "tynd",
    "plugin",
    "http",
    "websocket",
    "server",
    "bun",
    "bun-serve"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "private": false,
  "type": "module",
  "main": "./client.ts",
  "exports": {
    ".": "./client.ts",
    "./client": "./client.ts",
    "./backend": "./backend.ts",
    "./types": "./types.ts"
  },
  "tynd": {
    "kind": "standalone",
    "backend": true,
    "apis": [
      "network"
    ]
  },
  "peerDependencies": {
    "@tynd/core": "^1.0.0",
    "@tynd/plugin-sdk": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@tynd/core": {
      "optional": true
    },
    "@tynd/plugin-sdk": {
      "optional": true
    }
  },
  "files": [
    "client.ts",
    "backend.ts",
    "backend-transport.ts",
    "headers.ts",
    "types.ts",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.5",
    "typescript": "~7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
