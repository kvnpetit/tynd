{
  "name": "@tynd/plugin-gpu",
  "version": "1.0.0",
  "description": "GPU diagnostics, benchmark, and readiness checks for Tynd apps — WebGPU/WebGL2/WebGL1, pure JS.",
  "license": "Apache-2.0",
  "author": "Kevin Petit <74395438+kvnpetit@users.noreply.github.com> (https://github.com/kvnpetit)",
  "homepage": "https://tynd-apps.github.io/tynd/docs/v1.0/api/plugins/gpu",
  "funding": "https://github.com/sponsors/kvnpetit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tynd-apps/tynd.git",
    "directory": "plugins/standalone/gpu"
  },
  "bugs": {
    "url": "https://github.com/tynd-apps/tynd/issues"
  },
  "keywords": [
    "tynd",
    "plugin",
    "gpu",
    "webgpu",
    "webgl",
    "benchmark",
