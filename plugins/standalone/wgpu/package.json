{
  "name": "@tynd/plugin-wgpu",
  "version": "1.0.0",
  "description": "Native wgpu surface plugin for Tynd — Metal/Vulkan/D3D12 windows that bypass the webview renderer.",
  "license": "Apache-2.0",
  "author": "Kevin Petit <74395438+kvnpetit@users.noreply.github.com> (https://github.com/kvnpetit)",
  "homepage": "https://tynd-apps.github.io/tynd/docs/v1.0/api/plugins/wgpu",
  "funding": "https://github.com/sponsors/kvnpetit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tynd-apps/tynd.git",
    "directory": "plugins/standalone/wgpu"
  },
  "bugs": {
    "url": "https://github.com/tynd-apps/tynd/issues"
  },
  "keywords": [
    "tynd",
    "plugin",
    "wgpu",
    "webgpu",
    "metal",
    "vulkan",
    "dx12",
    "three",
    "babylon",
    "native",
    "renderer",
    "graphics"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "private": false,
  "type": "module",
  "main": "./client.ts",
  "exports": {
    ".": "./client.ts",
    "./client": "./client.ts",
    "./three-adapter": "./three-adapter.ts"
  },
  "tynd": {
    "kind": "standalone",
    "apis": [],
    "native": {
      "path": "./native",
      "crateName": "tynd-plugin-wgpu",
      "features": [
        "native"
      ]
    }
  },
  "peerDependencies": {
    "@tynd/core": "^1.0.0",
    "@tynd/plugin-sdk": "^1.0.0",
    "three": ">=0.158.0"
  },
  "files": [
    "client.ts",
    "wgpu.gen.ts",
    "three-adapter.ts",
    "native/**",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.5",
    "typescript": "~7.0.2"
  },
  "peerDependenciesMeta": {
    "@tynd/core": {
      "optional": true
    },
    "@tynd/plugin-sdk": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "experimental"
  },
  "sideEffects": false
}
