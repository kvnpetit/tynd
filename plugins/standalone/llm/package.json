{
  "name": "@tynd/plugin-llm",
  "version": "1.0.0",
  "description": "Local LLM inference for Tynd apps — GGUF via llama.cpp, native Rust.",
  "license": "Apache-2.0",
  "author": "Kevin Petit <74395438+kvnpetit@users.noreply.github.com> (https://github.com/kvnpetit)",
  "homepage": "https://kvnpetit.github.io/tynd/docs/v1.0/api/plugins/llm",
  "funding": "https://github.com/sponsors/kvnpetit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvnpetit/tynd.git",
    "directory": "plugins/standalone/llm"
  },
  "bugs": {
    "url": "https://github.com/kvnpetit/tynd/issues"
  },
  "keywords": [
    "tynd",
    "plugin",
    "llm",
    "ai",
    "inference",
    "llama",
    "gguf",
    "native"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "private": false,
  "type": "module",
  "main": "./client.ts",
  "exports": {
    ".": "./client.ts",
    "./client": "./client.ts",
    "./ai-sdk": "./ai-sdk.ts"
  },
  "tynd": {
    "kind": "standalone",
    "apis": [],
    "native": {
      "path": "./native",
      "crateName": "tynd-plugin-llm",
      "features": [
        "inference"
      ]
    }
  },
  "peerDependencies": {
    "@tynd/core": "^1.0.0",
    "@tynd/plugin-sdk": "^1.0.0",
    "@ai-sdk/provider": "^3.0.10 || ^4.0.39",
    "ai": "^6.0.0 || ^7.0.0"
  },
  "files": [
    "client.ts",
    "llm.gen.ts",
    "ai-sdk.ts",
    "native/**",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.39",
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.5",
    "typescript": "~7.0.2"
  },
  "peerDependenciesMeta": {
    "@tynd/core": {
      "optional": true
    },
    "@tynd/plugin-sdk": {
      "optional": true
    },
    "@ai-sdk/provider": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "experimental"
  },
  "sideEffects": false
}
