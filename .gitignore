# Dependencies
node_modules/

# Rust build output
target/

# Coverage output
coverage/

# Tynd build cache & release output
.tynd/
release/

# Temporary icon conversion (SVG → PNG by tynd build)
*.tynd.png

# Frontend bundles
dist/
dist-ssr/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor — keep shared VSCode config, ignore everything else
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp
*.swo
*~

# Environment
.env
.env.*

# TypeScript build cache
*.tsbuildinfo
.tmp/

# Bun
.bun/

# Package dry-run artifacts
*.tgz

# Rust coverage profiles
*.profraw

# Package-local generated output (from former nested .gitignore files)
/packages/plugin-sdk/docs/
# Mirrors of crates/plugin-sdk and crates/plugin-macros, generated by
# `bun run --cwd packages/plugin-sdk sync` for the npm tarball.
/packages/plugin-sdk/native/
/packages/plugin-sdk/native-macros/
/plugins/standalone/plugin-sdk-deps/
/apps/docs/.astro/
/apps/docs/.vercel/

# Generated by apps/docs prebuild (scripts/build-llms-txt.ts)
/apps/docs/public/llms*.txt
/apps/docs/public/docs/**/llms*.txt

# Native binaries staged into the tooling carriers by the release workflow
/npm/tooling-*/bin/*
!/npm/tooling-*/bin/.gitkeep
