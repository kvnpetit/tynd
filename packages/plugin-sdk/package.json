{
  "name": "@tynd/plugin-sdk",
  "version": "1.0.0",
  "description": "Rust SDK + JS helpers for authoring Tynd plugins that ship native code.",
  "license": "Apache-2.0",
  "author": "Kevin Petit <74395438+kvnpetit@users.noreply.github.com> (https://github.com/kvnpetit)",
  "homepage": "https://kvnpetit.github.io/tynd/",
  "funding": "https://github.com/sponsors/kvnpetit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvnpetit/tynd.git",
    "directory": "packages/plugin-sdk"
  },
  "bugs": {
    "url": "https://github.com/kvnpetit/tynd/issues"
  },
  "keywords": [
    "tynd",
    "plugin",
    "sdk",
    "rust",
    "native",
    "tauri-alternative",
    "electron-alternative",
    "wails-alternative"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./hooks": {
      "types": "./dist/hooks.d.mts",
      "import": "./dist/hooks.mjs",
      "default": "./dist/hooks.mjs"
    }
  },
  "scripts": {
    "build": "unbuild",
    "sync": "bun run scripts/sync.ts",
    "prepack": "bun run sync && bun run build"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "@typescript/typescript6": "~6.0.2",
    "typescript": "~7.0.2",
    "unbuild": "^3.6.1"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "hookable": "^6.1.2"
  },
  "peerDependencies": {
    "@tynd/core": ">=1.0.0 <2"
  },
  "files": [
    "dist",
    "native/**",
    "native-macros/**",
    "!**/target/**",
    "deny.toml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
