{
  "name": "@tynd/mcp",
  "version": "1.0.0",
  "description": "Native Rust Model Context Protocol server for Tynd.",
  "license": "Apache-2.0",
  "author": "Kevin Petit <74395438+kvnpetit@users.noreply.github.com> (https://github.com/kvnpetit)",
  "homepage": "https://tynd-apps.github.io/tynd/",
  "funding": "https://github.com/sponsors/kvnpetit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tynd-apps/tynd.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/tynd-apps/tynd/issues"
  },
  "keywords": [
    "tynd",
    "mcp",
    "model-context-protocol",
    "ai",
    "debugging",
    "rust"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "private": false,
  "type": "module",
  "sideEffects": false,
  "bin": {
    "tynd-mcp": "./bin/index.js"
  },
  "scripts": {
    "dev": "cargo run --manifest-path ../../Cargo.toml -p tynd-cli --bin tynd-mcp --",
    "build": "node --check bin/index.js",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@tynd/tooling": "1.0.0"
  },
  "files": [
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
