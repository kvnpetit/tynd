{
  "name": "@tynd/core",
  "version": "1.0.0",
  "description": "Tynd framework core — backend API (app.start, createEmitter) and typed frontend client.",
  "license": "Apache-2.0",
  "author": "Kevin Petit <74395438+kvnpetit@users.noreply.github.com> (https://github.com/kvnpetit)",
  "homepage": "https://tynd.kvnpetit.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tynd-apps/tynd.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/tynd-apps/tynd/issues"
  },
  "keywords": [
    "tynd",
    "ipc",
    "rpc",
    "typed",
    "desktop",
    "webview",
    "backend",
    "typescript"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "private": false,
  "type": "module",
  "files": [
    "src",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./config": "./src/config.ts",
    "./env": {
      "types": "./src/client/env.d.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "build:devalue": "bun build scripts/devalue-shim-entry.ts --target=browser --format=iife --minify --outfile=../host-rs/src/devalue.bundle.js"
  },
  "dependencies": {
    "c12": "^3.0.4",
    "cbor-x": "^1.6.0",
    "devalue": "^5.1.1",
    "mitt": "^3.0.1",
    "p-timeout": "^7.0.1",
    "pathe": "^2.0.3",
    "ts-pattern": "^5.7.0",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@types/bun": "1.3.13",
    "typescript": "~6.0.2"
  }
}
