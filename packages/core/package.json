{
  "name": "@tynd/core",
  "version": "1.0.0",
  "description": "Tynd framework core — backend API (app.start, createEmitter) and typed frontend client.",
  "license": "Apache-2.0",
  "author": "Kevin Petit <74395438+kvnpetit@users.noreply.github.com> (https://github.com/kvnpetit)",
  "homepage": "https://tynd-apps.github.io/tynd/docs/v1.0/api/",
  "funding": "https://github.com/sponsors/kvnpetit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tynd-apps/tynd.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/tynd-apps/tynd/issues"
  },
  "keywords": [
    "tynd",
    "ipc",
    "rpc",
    "typed",
    "desktop",
    "webview",
    "backend",
    "typescript",
    "tauri-alternative",
    "electron-alternative",
    "wails-alternative"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "private": false,
  "type": "module",
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/runtime/hook-fixture.ts",
    "!src/runtime/bun.fixture.ts",
    "!src/runtime/boot.fixture.ts",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./client/bridge": "./src/client/bridge.ts",
    "./plugin": "./src/plugin.ts",
    "./testing": "./src/testing.ts",
    "./env": {
      "types": "./src/client/env.d.ts"
    }
  },
  "scripts": {
    "build:devalue": "bun build scripts/devalue-shim-entry.ts --target=browser --format=iife --minify --outfile=../../crates/host/src/webview/shim/devalue.bundle.js"
  },
  "dependencies": {
    "devalue": "^6.0.3",
    "pathe": "^2.0.3",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.5",
    "typescript": "~7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
