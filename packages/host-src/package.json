{
  "name": "@tynd/host-src",
  "version": "1.0.0",
  "description": "Self-contained Rust host and runtime sources for Tynd custom builds.",
  "license": "Apache-2.0",
  "author": "Kevin Petit <74395438+kvnpetit@users.noreply.github.com> (https://github.com/kvnpetit)",
  "homepage": "https://kvnpetit.github.io/tynd/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvnpetit/tynd.git",
    "directory": "packages/host-src"
  },
  "bugs": {
    "url": "https://github.com/kvnpetit/tynd/issues"
  },
  "keywords": [
    "tynd",
    "rust",
    "source",
    "custom-build",
    "webview"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "private": false,
  "tynd": {
    "hostSrc": "./native",
    "crateName": "tynd-host"
  },
  "scripts": {
    "sync": "bun run scripts/sync.ts",
    "lock": "bun run scripts/sync.ts",
    "prepack": "bun run sync"
  },
  "files": [
    "native/**",
    "!native/target/**",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "smol-toml": "^1.9.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
