{
  "name": "@tynd/test",
  "version": "1.0.0",
  "description": "End-to-end test harness for Tynd apps: launch, drive and screenshot an app over the debug protocol.",
  "license": "Apache-2.0",
  "author": "Kevin Petit <74395438+kvnpetit@users.noreply.github.com> (https://github.com/kvnpetit)",
  "homepage": "https://kvnpetit.github.io/tynd/",
  "funding": "https://github.com/sponsors/kvnpetit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvnpetit/tynd.git",
    "directory": "packages/test"
  },
  "bugs": {
    "url": "https://github.com/kvnpetit/tynd/issues"
  },
  "keywords": [
    "tynd",
    "test",
    "e2e",
    "testing",
    "desktop",
    "bun"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./png": "./src/png.ts",
    "./protocol": "./src/protocol.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "typescript": "~7.0.2"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
