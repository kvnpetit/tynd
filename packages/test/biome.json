{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "root": false,
  "extends": ["../../biome.json"],
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/fixtures/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noExcessiveLinesPerFunction": "off"
          },
          "suspicious": {
            "noConsole": "off",
            "noEmptyBlockStatements": "off"
          }
        }
      }
    }
  ]
}
