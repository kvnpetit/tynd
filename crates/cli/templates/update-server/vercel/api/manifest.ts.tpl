// Tynd auto-updater — Vercel Edge Function template.
// Generated by `tynd updater server --deploy vercel`.
// Vercel Edge Functions run on the Vercel Edge Network — no R2/S3 SDK
// in scope, so this template proxies to an upstream manifest URL (the
// one you set via `tynd updater publish --public-base-url`) and adds:
//   - Strong ETag pass-through (304 conditional GETs).
//   - 60 s cache, immutable revalidate hint.
//   - Optional bearer-token gate via env `AUTH_TOKEN`. Without it the
//     manifest is public; it is signed, so clients still reject tampered
//     updates, but set AUTH_TOKEN if releases must stay private.
//   - CORS headers for desktop renderers fetching from a different origin.
// Range support for binary downloads is delegated to the upstream — the
// Edge Function just echoes the headers. Vercel doesn't proxy bodies of
// 206 responses well in some regions; if your binaries are >25 MB,
// prefer the Cloudflare worker template (it talks to R2 directly).
// Deploy: `vercel deploy --prod` from this directory.

export const config = { runtime: "edge" };

const PUBLIC_KEY = "${publicKey}";
const MANIFEST_URL = "${manifestUrl}";
const APP_ID = "${appId}";

export default async function handler(req: Request): Promise<Response> {
  const url = new URL(req.url);

  if (req.method === "OPTIONS") return cors(new Response(null, { status: 204 }));

  // Optional auth gate.
  const authToken = process.env.AUTH_TOKEN;
  if (authToken) {
    const got = req.headers.get("authorization")?.replace(/^Bearer\s+/i, "") ?? "";
    if (!(await tokenMatches(got, authToken))) {
      return cors(new Response("unauthorized", { status: 401 }));
    }
  }

  if (url.pathname === "/healthz") {
    return cors(new Response("ok", { status: 200 }));
  }

  if (url.pathname === "/manifest.json" || url.pathname === "/api/manifest") {
    return cors(await proxyManifest(req));
  }

  return cors(new Response("not found", { status: 404 }));
}

/**
 * Constant-time bearer token check: both sides are hashed to SHA-256 first,
 * so the XOR loop always runs over 32 bytes and leaks neither the token
 * length nor the position of the first mismatch.
 */
async function tokenMatches(given: string, expected: string): Promise<boolean> {
  const encoder = new TextEncoder();
  const [left, right] = await Promise.all([
    crypto.subtle.digest("SHA-256", encoder.encode(given)),
    crypto.subtle.digest("SHA-256", encoder.encode(expected)),
  ]);
  const a = new Uint8Array(left);
  const b = new Uint8Array(right);
  let diff = a.length ^ b.length;
  for (let i = 0; i < a.length; i++) diff |= (a[i] ?? 0) ^ (b[i] ?? 0);
  return diff === 0;
}

async function proxyManifest(req: Request): Promise<Response> {
  const ifNoneMatch = req.headers.get("if-none-match");
  const upstream = await fetch(MANIFEST_URL, {
    headers: ifNoneMatch ? { "if-none-match": ifNoneMatch } : {},
    // Edge runtime caches per-region for 60s; revalidate the rest.
    next: { revalidate: 60 },
  } as RequestInit);

  if (upstream.status === 304) return new Response(null, { status: 304 });
  if (!upstream.ok) return new Response("upstream offline", { status: 502 });

  const body = await upstream.arrayBuffer();
  const headers = new Headers(upstream.headers);
  headers.set("content-type", "application/json");
  headers.set("cache-control", "public, max-age=60");
  // Stamp a marker so the client can verify we hit the right pin.
  headers.set("x-tynd-app-id", APP_ID);
  return new Response(body, { status: 200, headers });
}

function cors(res: Response): Response {
  const headers = new Headers(res.headers);
  headers.set("access-control-allow-origin", "*");
  headers.set("access-control-allow-methods", "GET, HEAD, OPTIONS");
  headers.set("access-control-allow-headers", "authorization, if-none-match, range");
  headers.set("access-control-expose-headers", "etag, content-range, content-length, accept-ranges");
  return new Response(res.body, { status: res.status, headers });
}

// Pinned for clients that ask the proxy for the trusted pubkey. Not
// security-load-bearing — the desktop client embeds the pubkey at
// build time and only uses this as a sanity check.
export const PINNED_PUBLIC_KEY = PUBLIC_KEY;
