// Tynd auto-updater — Cloudflare Worker template.
// Generated by `tynd updater server --deploy cloudflare`.
// Endpoints:
//   GET /manifest.json
//     Returns the current update manifest from R2 (key:
//     `<APP_ID>/latest/manifest.json`). Strong ETag + 60 s cache.
//   GET /artifact/<app-id>/<version>/<rest...>
//     Streams the artifact from R2 with full HTTP Range support so
//     interrupted downloads resume instead of restarting.
//   GET /healthz
//     200 OK liveness check. Useful for uptime monitors.
// Pre-reqs:
//   - R2 bucket bound as `BUCKET` (see wrangler.toml).
//   - Optional KV namespace `RATELIMIT` for per-IP throttling.
//   - Optional `AUTH_TOKEN` env-var to gate access (Authorization: Bearer …).
//     Without it every endpoint is public: anyone can read the manifest and
//     download artifacts. Manifests are signed, so clients still reject any
//     tampered update, but set AUTH_TOKEN if releases must stay private.

const PUBLIC_KEY = "${publicKey}";
const APP_ID = "${appId}";

interface Env {
  BUCKET: R2Bucket;
  RATELIMIT?: KVNamespace;
  /** When set, every request must carry `Authorization: Bearer <token>`. */
  AUTH_TOKEN?: string;
  /** Per-minute request cap per (IP, platform) — default 60. */
  RATE_LIMIT_PER_MIN?: string;
}

export default {
  async fetch(req: Request, env: Env): Promise<Response> {
    const url = new URL(req.url);

    // CORS preflight: keep it permissive — clients are first-party desktop
    // apps but the manifest is sometimes fetched from a renderer that lives
    // on `https://app.example.com`.
    if (req.method === "OPTIONS") return cors(new Response(null, { status: 204 }));

    if (url.pathname === "/healthz") {
      return cors(new Response("ok", { status: 200 }));
    }

    // Optional auth — short-circuit before touching R2 or KV so unauth'd
    // traffic doesn't burn read units.
    if (env.AUTH_TOKEN) {
      const token = req.headers.get("authorization")?.replace(/^Bearer\s+/i, "") ?? "";
      if (!(await tokenMatches(token, env.AUTH_TOKEN))) {
        return cors(new Response("unauthorized", { status: 401 }));
      }
    }

    // Optional rate limit — KV-backed counter keyed by IP. Skip when the
    // RATELIMIT binding isn't provisioned.
    if (env.RATELIMIT) {
      const ip = req.headers.get("cf-connecting-ip") ?? "unknown";
      const limited = await checkRateLimit(env.RATELIMIT, ip, Number(env.RATE_LIMIT_PER_MIN ?? 60));
      if (limited) return cors(new Response("rate limit", { status: 429 }));
    }

    if (url.pathname === "/manifest.json" || url.pathname === "/") {
      return cors(await serveManifest(env, req));
    }

    // /artifact/<app-id>/<version>/<...>  — stream binary or patch from R2.
    if (url.pathname.startsWith("/artifact/")) {
      const key = url.pathname.replace(/^\/artifact\//, "");
      return cors(await serveR2Object(env.BUCKET, key, req));
    }

    return cors(new Response("not found", { status: 404 }));
  },
};

/**
 * Constant-time bearer token check: both sides are hashed to SHA-256 first,
 * so the XOR loop always runs over 32 bytes and leaks neither the token
 * length nor the position of the first mismatch.
 */
async function tokenMatches(given: string, expected: string): Promise<boolean> {
  const encoder = new TextEncoder();
  const [left, right] = await Promise.all([
    crypto.subtle.digest("SHA-256", encoder.encode(given)),
    crypto.subtle.digest("SHA-256", encoder.encode(expected)),
  ]);
  const a = new Uint8Array(left);
  const b = new Uint8Array(right);
  let diff = a.length ^ b.length;
  for (let i = 0; i < a.length; i++) diff |= (a[i] ?? 0) ^ (b[i] ?? 0);
  return diff === 0;
}

async function serveManifest(env: Env, req: Request): Promise<Response> {
  const key = APP_ID + "/latest/manifest.json";
  // Conditional GET — return 304 when ETag matches.
  const ifNoneMatch = req.headers.get("if-none-match") ?? undefined;
  const opts: R2GetOptions = ifNoneMatch ? { onlyIf: { etagMatches: ifNoneMatch } } : {};
  const obj = await env.BUCKET.get(key, opts);
  if (!obj) {
    if (ifNoneMatch) return new Response(null, { status: 304 });
    return new Response("manifest not found", { status: 404 });
  }
  const etag = obj.httpEtag;
  return new Response(obj.body, {
    status: 200,
    headers: {
      "content-type": "application/json",
      "cache-control": "public, max-age=60",
      etag,
    },
  });
}

/**
 * Stream an object from R2 honouring the optional `Range` header so
 * resumed downloads cost only the missing bytes. Returns 206 Partial
 * Content when a range was requested and satisfied.
 */
async function serveR2Object(bucket: R2Bucket, key: string, req: Request): Promise<Response> {
  const range = parseRange(req.headers.get("range"));
  const opts: R2GetOptions = range ? { range } : {};
  const obj = await bucket.get(key, opts);
  if (!obj) return new Response("not found", { status: 404 });

  const headers: Record<string, string> = {
    "content-type": detectContentType(key),
    etag: obj.httpEtag,
    "accept-ranges": "bytes",
    "cache-control": "public, max-age=31536000, immutable",
  };
  if (range) {
    const start = "offset" in range ? range.offset : 0;
    const length = "length" in range ? range.length : obj.size;
    const end = start + length - 1;
    headers["content-range"] = `bytes ${start}-${end}/${obj.size}`;
    headers["content-length"] = String(length);
    return new Response(obj.body, { status: 206, headers });
  }
  headers["content-length"] = String(obj.size);
  return new Response(obj.body, { status: 200, headers });
}

function parseRange(h: string | null): R2Range | null {
  if (!h) return null;
  const m = h.match(/^bytes=(\d+)-(\d*)$/);
  if (!m?.[1]) return null;
  const start = Number(m[1]);
  const end = m[2] ? Number(m[2]) : undefined;
  if (Number.isNaN(start)) return null;
  if (end !== undefined && (Number.isNaN(end) || end < start)) return null;
  if (end === undefined) return { offset: start };
  return { offset: start, length: end - start + 1 };
}

function detectContentType(key: string): string {
  if (key.endsWith(".json")) return "application/json";
  if (key.endsWith(".sig")) return "text/plain";
  if (key.endsWith(".bsdiff.zst")) return "application/octet-stream";
  return "application/octet-stream";
}

/** KV-backed rolling 60-second window. Cheap; one read + one write per request. */
async function checkRateLimit(kv: KVNamespace, ip: string, perMin: number): Promise<boolean> {
  const bucket = Math.floor(Date.now() / 60_000);
  const key = `${ip}:${bucket}`;
  const raw = await kv.get(key);
  const count = raw ? Number(raw) : 0;
  if (count >= perMin) return true;
  await kv.put(key, String(count + 1), { expirationTtl: 90 });
  return false;
}

function cors(res: Response): Response {
  const headers = new Headers(res.headers);
  headers.set("access-control-allow-origin", "*");
  headers.set("access-control-allow-methods", "GET, HEAD, OPTIONS");
  headers.set("access-control-allow-headers", "authorization, if-none-match, range");
  headers.set("access-control-expose-headers", "etag, content-range, content-length, accept-ranges");
  return new Response(res.body, { status: res.status, headers });
}

// Embedded so frontends that hit this worker for a quick "what pubkey
// should I trust?" probe get a typed answer instead of having to ship
// it separately. Not security-load-bearing — the client app already
// has the key baked in at build time.
export const PINNED_PUBLIC_KEY = PUBLIC_KEY;
