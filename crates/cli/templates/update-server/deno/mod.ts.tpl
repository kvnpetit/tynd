// Tynd auto-updater — Deno Deploy template.
// Generated by `tynd updater server --deploy deno`.
// Endpoints:
//   GET /manifest.json
//     Returns the manifest stored in Deno KV (key: ["manifest", <APP_ID>]).
//     Falls back to a fetch from MANIFEST_URL when KV is empty (useful
//     for the first deploy before you've populated KV).
//   POST /admin/manifest
//     Replaces the manifest in KV. Requires `Authorization: Bearer
//     ${ADMIN_TOKEN}` (set via `deployctl deploy --env ADMIN_TOKEN=…`).
//     Hooked up so a CI step can `curl --data-binary @manifest.json`
//     after `tynd updater publish --target manifest-only`.
//   GET /healthz — liveness check.
// Deploy: `deployctl deploy --project=tynd-updates mod.ts`.

const PUBLIC_KEY = "${publicKey}";
const MANIFEST_URL = "${manifestUrl}";
const APP_ID = "${appId}";

const kv = await Deno.openKv();

Deno.serve(async (req: Request) => {
  const url = new URL(req.url);

  if (req.method === "OPTIONS") return cors(new Response(null, { status: 204 }));

  if (url.pathname === "/healthz") {
    return cors(new Response("ok", { status: 200 }));
  }

  if (url.pathname === "/manifest.json" || url.pathname === "/") {
    return cors(await serveManifest(req));
  }

  if (url.pathname === "/admin/manifest" && req.method === "POST") {
    return cors(await replaceManifest(req));
  }

  return cors(new Response("not found", { status: 404 }));
});

async function serveManifest(req: Request): Promise<Response> {
  const ifNoneMatch = req.headers.get("if-none-match");
  const stored = await kv.get<{ json: string; etag: string }>(["manifest", APP_ID]);
  const value = stored.value;

  if (value) {
    if (ifNoneMatch && ifNoneMatch === value.etag) {
      return new Response(null, { status: 304 });
    }
    return new Response(value.json, {
      status: 200,
      headers: {
        "content-type": "application/json",
        "cache-control": "public, max-age=60",
        etag: value.etag,
      },
    });
  }

  // KV empty — fall back to upstream so a fresh deploy still works.
  const upstream = await fetch(MANIFEST_URL);
  if (!upstream.ok) return new Response("upstream offline", { status: 502 });
  const body = await upstream.text();
  return new Response(body, {
    status: 200,
    headers: { "content-type": "application/json", "cache-control": "public, max-age=60" },
  });
}

async function replaceManifest(req: Request): Promise<Response> {
  const adminToken = Deno.env.get("ADMIN_TOKEN");
  if (!adminToken) {
    return new Response("ADMIN_TOKEN env var not set", { status: 503 });
  }
  const got = req.headers.get("authorization")?.replace(/^Bearer\s+/i, "") ?? "";
  if (!(await tokenMatches(got, adminToken))) {
    return new Response("unauthorized", { status: 401 });
  }
  const body = await req.text();
  // Validate it parses as JSON before persisting.
  try {
    JSON.parse(body);
  } catch {
    return new Response("body is not valid JSON", { status: 400 });
  }
  const etag = `"${await sha256Hex(body)}"`;
  await kv.set(["manifest", APP_ID], { json: body, etag });
  return new Response(JSON.stringify({ ok: true, etag }), {
    status: 200,
    headers: { "content-type": "application/json" },
  });
}

async function sha256Hex(input: string): Promise<string> {
  const buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(input));
  return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, "0")).join("");
}

/**
 * Constant-time bearer token check: both sides are hashed to SHA-256 first,
 * so the XOR loop always runs over 32 bytes and leaks neither the token
 * length nor the position of the first mismatch.
 */
async function tokenMatches(given: string, expected: string): Promise<boolean> {
  const encoder = new TextEncoder();
  const [left, right] = await Promise.all([
    crypto.subtle.digest("SHA-256", encoder.encode(given)),
    crypto.subtle.digest("SHA-256", encoder.encode(expected)),
  ]);
  const a = new Uint8Array(left);
  const b = new Uint8Array(right);
  let diff = a.length ^ b.length;
  for (let i = 0; i < a.length; i++) diff |= (a[i] ?? 0) ^ (b[i] ?? 0);
  return diff === 0;
}

function cors(res: Response): Response {
  const headers = new Headers(res.headers);
  headers.set("access-control-allow-origin", "*");
  headers.set("access-control-allow-methods", "GET, POST, HEAD, OPTIONS");
  headers.set("access-control-allow-headers", "authorization, if-none-match, content-type");
  headers.set("access-control-expose-headers", "etag");
  return new Response(res.body, { status: res.status, headers });
}

// Pinned for sanity-check probes. Desktop clients embed the pubkey at
// build time; this constant lets ops verify the deployed worker matches.
export const PINNED_PUBLIC_KEY = PUBLIC_KEY;
